    echo "installing Node-RED"
    sudo -E npm install -g --unsafe-perm node-red

    #check everything is installed
    echo "Node Version:"
    node --version
    echo "NPM version:"
    npm --version
    echo "Node Red Version:"
    node-red --version

    # edit: 12 nov 26 npm install doesn't create a service, and the export above
    # doesn't reach it - create nodered.service with the memory limit built in
    echo "creating nodered.service"
    NODERED_BIN=$(command -v node-red)
sudo tee /etc/systemd/system/nodered. service > /dev/null <<EOF
[Unit]
Description=Node-RED
After=network.target

[Service]
Type=simple
User=$USER
WorkingDirectory=/home/$USER
Environment="NODE_OPTIONS=-- max_old_space_size=1024"
ExecStart=$NODERED_BIN
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

    # Install NodeRed for RPI
    sudo systemctl daemon-reload
    sudo systemctl enable nodered.service                  # Ensures Nodered runs on startup
